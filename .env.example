# Copy to .env; never commit API keys.
OPENAI_API_KEY=
STEEL_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4096
MODEL_TIMEOUT_SECONDS=45
BROWSER_TIMEOUT_SECONDS=10
# A trusted operator-owned JSON file. Default is browser_worker/sites.json.
WORKER_SITES_FILE=
# steel (default) or local (for the included local catalog).
WORKER_BROWSER=steel
# Optional installed Chromium/Chrome executable for local mode.
WORKER_BROWSER_EXECUTABLE=
# Optional bearer token for the API. Bind to loopback when unset.
WORKER_API_TOKEN=
